/** Shared default for bank selection and newly imported accounts; issuer keys stay canonical. */
export function preferredBankStyle(key: string): BankAccountStyle | undefined {
  const base = key.endsWith('_color') ? key.slice(0, -6) : key;
  const bank = BANK_ACCOUNT_STYLES.find((item: BankAccountStyle) => item.key === base);
  if (bank === undefined) { return undefined; }
  return bank.preferredVariant === 'color' ? (BANK_ACCOUNT_STYLES.find((item: BankAccountStyle) => item.key === base + '_color') || bank) : bank;
}
