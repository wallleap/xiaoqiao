  "CREATE TRIGGER batch_commit BEFORE UPDATE OF status ON import_batches WHEN NEW.status='committed' AND OLD.status<>'committed'\nBEGIN\n SELECT CASE WHEN NEW.selected_count<>(SELECT COUNT(*) FROM import_rows WHERE batch_id=NEW.id AND selected=1)\n OR NEW.total_count<>(SELECT COUNT(*) FROM import_rows WHERE batch_id=NEW.id)\n OR NEW.selected_count<>((SELECT COUNT(*) FROM transactions WHERE import_batch_id=NEW.id AND posting_state='posted' AND deleted_at_ms IS NULL)+(SELECT COUNT(*) FROM expense_recoveries WHERE import_batch_id=NEW.id AND deleted_at_ms IS NULL))\n THEN RAISE(ABORT,'batch counts/unpublished records mismatch') END;\nEND;",
  "CREATE TRIGGER batch_policy_locked BEFORE UPDATE OF balance_mode,book_id ON import_batches\nWHEN EXISTS(SELECT 1 FROM transactions WHERE import_batch_id=OLD.id) OR EXISTS(SELECT 1 FROM expense_recoveries WHERE import_batch_id=OLD.id)\nBEGIN SELECT RAISE(ABORT,'batch policy is in use'); END;",
  "CREATE TRIGGER fx_transfer_details_insert BEFORE INSERT ON fx_transfer_details\n WHEN NOT EXISTS(SELECT 1 FROM transactions WHERE id=NEW.transaction_id AND kind='transfer' AND posting_state='draft')\n BEGIN SELECT RAISE(ABORT,'transfer details require draft transfer'); END;",
  "CREATE TRIGGER fx_transfer_details_update BEFORE UPDATE ON fx_transfer_details\n WHEN NEW.transaction_id<>OLD.transaction_id OR NOT EXISTS(SELECT 1 FROM transactions WHERE id=OLD.transaction_id AND posting_state='draft')\n BEGIN SELECT RAISE(ABORT,'posted transfer details are immutable'); END;",
  "CREATE VIEW v_transfer_details AS SELECT d.*,d.currency_id AS to_currency_id,d.in_minor AS principal_minor,d.fee_minor AS book_fee_minor FROM transfer_details d UNION ALL SELECT transaction_id,purpose,currency_id,from_account_id,to_account_id,out_minor,in_minor,fee_minor,coupon_minor,fee_in_expense,fee_in_budget,to_currency_id,principal_minor,book_fee_minor FROM fx_transfer_details;",
  "CREATE VIEW v_expense_recoveries AS SELECT r.id,r.transaction_id,r.book_id,r.kind,r.amount_minor,r.account_id,r.balance_mode,r.occurred_at_ms,r.local_date,r.offset_minutes,r.note,r.import_batch_id,r.source_record_id,r.import_row_id,r.created_at_ms,r.updated_at_ms,r.revision,r.deleted_at_ms,COALESCE(r.book_minor,r.amount_minor) AS book_minor,COALESCE(r.account_minor,r.amount_minor) AS account_minor,COALESCE(r.account_currency_id,t.currency_id) AS account_currency_id,r.fx_snapshot,t.currency_id,t.book_currency_id,t.category_id,t.spending_nature_id,t.include_in_budget,t.merchant_name_snapshot,t.address_text,t.latitude_e6,t.longitude_e6 FROM expense_recoveries r JOIN v_posted_transactions t ON t.id=r.transaction_id WHERE r.deleted_at_ms IS NULL AND (r.import_batch_id IS NULL OR EXISTS(SELECT 1 FROM import_batches b WHERE b.id=r.import_batch_id AND b.status='committed'));",
  "CREATE TRIGGER recovery_insert_guard BEFORE INSERT ON expense_recoveries\nBEGIN\n SELECT CASE WHEN NOT EXISTS(SELECT 1 FROM transactions t WHERE t.id=NEW.transaction_id AND t.book_id=NEW.book_id AND t.kind='expense' AND t.deleted_at_ms IS NULL AND t.posting_state='posted') THEN RAISE(ABORT,'RECOVERY_SOURCE_INVALID') END;\n SELECT CASE WHEN NEW.import_row_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM import_rows WHERE id=NEW.import_row_id AND batch_id=NEW.import_batch_id AND selected=1 AND validation_status IN ('valid','duplicate') AND EXISTS(SELECT 1 FROM import_batches b WHERE b.id=NEW.import_batch_id AND b.book_id=NEW.book_id AND b.balance_mode=NEW.balance_mode AND b.status='committing')) THEN RAISE(ABORT,'RECOVERY_SOURCE_INVALID') END;\n SELECT CASE WHEN NEW.account_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM accounts WHERE id=NEW.account_id AND currency_id=COALESCE(NEW.account_currency_id,(SELECT currency_id FROM transactions WHERE id=NEW.transaction_id)) AND deleted_at_ms IS NULL AND archived_at_ms IS NULL) THEN RAISE(ABORT,'ACCOUNT_UNAVAILABLE') END;\n SELECT CASE WHEN NEW.deleted_at_ms IS NULL AND NEW.amount_minor+COALESCE((SELECT SUM(amount_minor) FROM expense_recoveries WHERE transaction_id=NEW.transaction_id AND deleted_at_ms IS NULL),0)>(SELECT paid_minor FROM transactions WHERE id=NEW.transaction_id) THEN RAISE(ABORT,'RECOVERY_EXCEEDS_PAID') END;\nEND;",
  "CREATE TRIGGER recovery_update_guard BEFORE UPDATE ON expense_recoveries\nBEGIN\n SELECT CASE WHEN NEW.id<>OLD.id OR NEW.transaction_id<>OLD.transaction_id OR NEW.book_id<>OLD.book_id OR NEW.balance_mode<>OLD.balance_mode OR NEW.import_batch_id IS NOT OLD.import_batch_id OR NEW.source_record_id IS NOT OLD.source_record_id OR NEW.import_row_id IS NOT OLD.import_row_id THEN RAISE(ABORT,'RECOVERY_IDENTITY_LOCKED') END;\n SELECT CASE WHEN NEW.deleted_at_ms IS NULL AND NEW.amount_minor+COALESCE((SELECT SUM(amount_minor) FROM expense_recoveries WHERE transaction_id=NEW.transaction_id AND deleted_at_ms IS NULL AND id<>OLD.id),0)>(SELECT paid_minor FROM transactions WHERE id=NEW.transaction_id) THEN RAISE(ABORT,'RECOVERY_EXCEEDS_PAID') END;\n SELECT CASE WHEN NEW.deleted_at_ms IS NULL AND NEW.account_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM accounts WHERE id=NEW.account_id AND currency_id=COALESCE(NEW.account_currency_id,(SELECT currency_id FROM transactions WHERE id=NEW.transaction_id)) AND deleted_at_ms IS NULL AND (archived_at_ms IS NULL OR id=OLD.account_id)) THEN RAISE(ABORT,'ACCOUNT_UNAVAILABLE') END;\nEND;",
  "CREATE TRIGGER recovered_expense_guard BEFORE UPDATE OF paid_minor,book_minor,deleted_at_ms,kind,currency_id,book_currency_id ON transactions\nWHEN EXISTS(SELECT 1 FROM expense_recoveries WHERE transaction_id=OLD.id AND deleted_at_ms IS NULL)\nBEGIN\n SELECT CASE WHEN NEW.deleted_at_ms IS NOT NULL THEN RAISE(ABORT,'EXPENSE_HAS_RECOVERIES') END;\n SELECT CASE WHEN NEW.kind<>'expense' OR NEW.currency_id<>OLD.currency_id OR NEW.book_currency_id<>OLD.book_currency_id OR NEW.paid_minor<(SELECT SUM(amount_minor) FROM expense_recoveries WHERE transaction_id=OLD.id AND deleted_at_ms IS NULL) OR NEW.book_minor<(SELECT SUM(COALESCE(book_minor,amount_minor)) FROM expense_recoveries WHERE transaction_id=OLD.id AND deleted_at_ms IS NULL) THEN RAISE(ABORT,'RECOVERY_EXCEEDS_PAID') END;\nEND;",
  "CREATE TRIGGER transaction_publish BEFORE UPDATE OF posting_state ON transactions\n WHEN NEW.posting_state='posted' AND OLD.posting_state='draft'\n BEGIN\n SELECT CASE WHEN NOT EXISTS(SELECT 1 FROM books WHERE id=NEW.book_id AND deleted_at_ms IS NULL)\n OR (NEW.category_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM categories WHERE id=NEW.category_id AND deleted_at_ms IS NULL) AND NOT (NEW.category_id=OLD.category_id AND EXISTS(SELECT 1 FROM category_history WHERE id=NEW.category_id AND book_id=NEW.book_id AND kind=NEW.kind)))\n OR EXISTS(SELECT 1 FROM account_movements m JOIN accounts a ON a.id=m.account_id WHERE m.transaction_id=NEW.id AND a.deleted_at_ms IS NOT NULL)\n THEN RAISE(ABORT,'source entity is deleted') END;\n SELECT CASE WHEN EXISTS(SELECT 1 FROM account_movements WHERE transaction_id=NEW.id AND occurred_at_ms<>NEW.occurred_at_ms)\n THEN RAISE(ABORT,'settlement time mismatch') END;\n SELECT CASE WHEN NEW.currency_id=NEW.book_currency_id AND NEW.paid_minor<>NEW.book_minor\n THEN RAISE(ABORT,'same currency book amount mismatch') END;\n SELECT CASE WHEN NEW.currency_id<>NEW.book_currency_id AND NEW.book_minor IS NOT NULL AND NOT EXISTS(\n SELECT 1 FROM fx_snapshots f WHERE f.transaction_id=NEW.id AND f.role='book'\n AND f.from_currency_id=NEW.currency_id AND f.to_currency_id=NEW.book_currency_id\n AND f.from_minor=NEW.paid_minor AND f.to_minor=NEW.book_minor)\n THEN RAISE(ABORT,'missing book FX snapshot') END;\n SELECT CASE WHEN NEW.kind='transfer' AND NOT EXISTS(SELECT 1 FROM v_transfer_details WHERE transaction_id=NEW.id) AND (\n (SELECT COUNT(*) FROM account_movements WHERE transaction_id=NEW.id)<>2 OR\n (SELECT COUNT(DISTINCT account_id) FROM account_movements WHERE transaction_id=NEW.id)<>2 OR\n NOT EXISTS(SELECT 1 FROM account_movements WHERE transaction_id=NEW.id AND leg='transfer_out' AND currency_id=NEW.currency_id AND delta_minor=-NEW.paid_minor) OR\n NOT EXISTS(SELECT 1 FROM account_movements WHERE transaction_id=NEW.id AND leg='transfer_in'))\n THEN RAISE(ABORT,'incomplete transfer') END;\n SELECT CASE WHEN EXISTS(SELECT 1 FROM v_transfer_details d WHERE d.transaction_id=NEW.id AND (\n NEW.kind<>'transfer' OR NEW.currency_id<>d.currency_id OR NEW.paid_minor<>d.principal_minor OR\n NOT EXISTS(SELECT 1 FROM accounts WHERE id=d.from_account_id AND currency_id=d.currency_id AND deleted_at_ms IS NULL) OR\n NOT EXISTS(SELECT 1 FROM accounts WHERE id=d.to_account_id AND currency_id=d.to_currency_id AND deleted_at_ms IS NULL) OR\n (d.purpose IN ('credit_repayment','loan_repayment') AND NOT EXISTS(SELECT 1 FROM accounts WHERE id=d.to_account_id AND kind='liability')) OR\n (SELECT COUNT(*) FROM account_movements WHERE transaction_id=NEW.id)<>(CASE WHEN d.out_minor=0 THEN 1 ELSE 2 END) OR\n NOT EXISTS(SELECT 1 FROM account_movements WHERE transaction_id=NEW.id AND leg='transfer_in' AND account_id=d.to_account_id AND currency_id=d.to_currency_id AND delta_minor=d.in_minor) OR\n (d.out_minor>0 AND NOT EXISTS(SELECT 1 FROM account_movements WHERE transaction_id=NEW.id AND leg='transfer_out' AND account_id=d.from_account_id AND currency_id=d.currency_id AND delta_minor=-d.out_minor)) OR\n EXISTS(SELECT 1 FROM account_movements WHERE transaction_id=NEW.id AND leg NOT IN ('transfer_out','transfer_in'))))\n THEN RAISE(ABORT,'transfer details do not match actual settlement') END;\n SELECT CASE WHEN NEW.kind<>'transfer' AND ((SELECT COUNT(*) FROM account_movements WHERE transaction_id=NEW.id)>1\n OR EXISTS(SELECT 1 FROM account_movements WHERE transaction_id=NEW.id AND leg<>NEW.kind))\n THEN RAISE(ABORT,'wrong income/expense settlement') END;\n SELECT CASE WHEN (NEW.kind<>'transfer' OR NOT EXISTS(SELECT 1 FROM v_transfer_details WHERE transaction_id=NEW.id)) AND EXISTS(SELECT 1 FROM account_movements m WHERE m.transaction_id=NEW.id\n AND m.currency_id=NEW.currency_id AND abs(m.delta_minor)<>NEW.paid_minor)\n THEN RAISE(ABORT,'same currency settlement mismatch') END;\n SELECT CASE WHEN EXISTS(SELECT 1 FROM account_movements m WHERE m.transaction_id=NEW.id AND m.currency_id<>NEW.currency_id\n AND NOT EXISTS(SELECT 1 FROM fx_snapshots f WHERE f.transaction_id=NEW.id AND f.role='settlement' AND f.account_movement_id=m.id\n AND f.from_currency_id=NEW.currency_id AND f.to_currency_id=m.currency_id AND f.from_minor=NEW.paid_minor AND f.to_minor=abs(m.delta_minor)))\n THEN RAISE(ABORT,'missing settlement FX snapshot') END;\n SELECT CASE WHEN EXISTS(SELECT 1 FROM fx_snapshots f WHERE f.transaction_id=NEW.id AND (\n f.from_currency_id<>NEW.currency_id OR f.from_minor<>NEW.paid_minor OR\n (f.role='book' AND (NEW.book_minor IS NULL OR f.to_currency_id<>NEW.book_currency_id OR f.to_minor<>NEW.book_minor)) OR\n (f.role='settlement' AND NOT EXISTS(SELECT 1 FROM account_movements m WHERE m.id=f.account_movement_id AND m.transaction_id=NEW.id\n AND m.currency_id=f.to_currency_id AND abs(m.delta_minor)=f.to_minor))))\n THEN RAISE(ABORT,'FX snapshot does not match transaction') END;\n SELECT CASE WHEN EXISTS(SELECT 1 FROM transaction_attachments a JOIN attachments f ON f.id=a.attachment_id\n WHERE a.transaction_id=NEW.id AND (f.state<>'ready' OR f.deleted_at_ms IS NOT NULL))\n THEN RAISE(ABORT,'attachment not ready') END;\n SELECT CASE WHEN NEW.import_row_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM import_rows r WHERE r.id=NEW.import_row_id AND r.selected=1\n AND r.validation_status IN ('valid','duplicate') AND (r.validation_status<>'duplicate' OR NEW.duplicate_override=1))\n THEN RAISE(ABORT,'import row not selected/confirmed') END;\n END;",
  "CREATE VIEW v_book_totals AS\n SELECT book_id,book_currency_id,SUM(expense_minor) AS expense_minor,SUM(income_minor) AS income_minor FROM (\n SELECT t.book_id,t.book_currency_id,CASE WHEN t.kind='expense' THEN t.book_minor WHEN t.kind='transfer' AND d.fee_in_expense=1 THEN d.book_fee_minor ELSE 0 END AS expense_minor,CASE WHEN t.kind='income' THEN t.book_minor ELSE 0 END AS income_minor FROM v_posted_transactions t LEFT JOIN v_transfer_details d ON d.transaction_id=t.id\n UNION ALL SELECT book_id,book_currency_id,-book_minor,0 FROM v_expense_recoveries) GROUP BY book_id,book_currency_id;",
  "CREATE VIEW v_budget_expense_flows AS\n SELECT id,book_id,category_id,spending_nature_id,occurred_local_date AS local_date,book_minor AS amount_minor FROM v_posted_transactions WHERE kind='expense' AND include_in_budget=1\n UNION ALL SELECT id,book_id,category_id,spending_nature_id,local_date,-book_minor FROM v_expense_recoveries WHERE include_in_budget=1\n UNION ALL SELECT t.id,t.book_id,NULL,NULL,t.occurred_local_date,d.book_fee_minor FROM v_posted_transactions t JOIN v_transfer_details d ON d.transaction_id=t.id WHERE d.fee_in_expense=1 AND d.fee_in_budget=1;",
  "CREATE VIEW v_prepaid_events AS SELECT e.* FROM prepaid_events e WHERE posting_state='posted' AND deleted_at_ms IS NULL;",
  "CREATE VIEW v_prepaid_balances AS\n SELECT p.*,\n COALESCE((SELECT SUM(amount_minor) FROM v_prepaid_events WHERE project_id=p.id AND kind='fund'),0) AS funded_minor,\n COALESCE((SELECT SUM(amount_minor) FROM v_prepaid_events WHERE project_id=p.id AND kind='consume'),0) AS consumed_minor,\n COALESCE((SELECT SUM(amount_minor) FROM v_prepaid_events WHERE project_id=p.id AND kind='refund'),0) AS refunded_minor,\n COALESCE((SELECT SUM(CASE WHEN kind='fund' THEN amount_minor ELSE -amount_minor END) FROM v_prepaid_events WHERE project_id=p.id),0) AS remaining_minor,\n COALESCE((SELECT SUM(CASE WHEN kind='fund' THEN book_minor ELSE -book_minor END) FROM v_prepaid_events WHERE project_id=p.id),0) AS remaining_book_minor\n FROM prepaid_projects p;",
  "CREATE TRIGGER prepaid_project_currency_lock BEFORE UPDATE OF book_id,currency_id ON prepaid_projects\n BEGIN SELECT RAISE(ABORT,'PREPAID_CHANGED'); END;",
  "CREATE TRIGGER prepaid_event_insert BEFORE INSERT ON prepaid_events\n BEGIN\n SELECT CASE WHEN NEW.posting_state<>'draft' THEN RAISE(ABORT,'PREPAID_HISTORY_LOCKED') END;\n SELECT CASE WHEN NEW.account_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM accounts WHERE id=NEW.account_id AND archived_at_ms IS NULL AND deleted_at_ms IS NULL) THEN RAISE(ABORT,'ACCOUNT_UNAVAILABLE') END;\n END;",
  "CREATE TRIGGER prepaid_event_locked BEFORE UPDATE OF id,project_id,sequence_no,kind,amount_minor,book_minor,account_id,account_currency_id,cash_minor,cash_book_minor,quote_json,transaction_id,local_date,occurred_at_ms,offset_minutes,note ON prepaid_events\n WHEN OLD.posting_state='posted'\n BEGIN SELECT RAISE(ABORT,'PREPAID_HISTORY_LOCKED'); END;",
  "CREATE TRIGGER prepaid_event_no_draft BEFORE UPDATE OF posting_state ON prepaid_events\n WHEN OLD.posting_state='posted'\n BEGIN SELECT RAISE(ABORT,'PREPAID_HISTORY_LOCKED'); END;",
  "CREATE TRIGGER prepaid_event_undo BEFORE UPDATE OF deleted_at_ms ON prepaid_events\n WHEN OLD.deleted_at_ms IS NULL AND NEW.deleted_at_ms IS NOT NULL\n BEGIN\n SELECT CASE WHEN EXISTS(SELECT 1 FROM v_prepaid_events WHERE project_id=OLD.project_id AND sequence_no>OLD.sequence_no) THEN RAISE(ABORT,'PREPAID_UNDO_ORDER') END;\n END;",
  "CREATE TRIGGER prepaid_allocation_insert BEFORE INSERT ON prepaid_allocations\n BEGIN\n SELECT CASE WHEN NOT EXISTS(SELECT 1 FROM prepaid_events e JOIN v_prepaid_events f ON f.id=NEW.fund_id WHERE e.id=NEW.event_id AND e.posting_state='draft' AND e.kind IN ('consume','refund') AND f.kind='fund' AND f.project_id=e.project_id AND f.sequence_no<e.sequence_no) THEN RAISE(ABORT,'PREPAID_ALLOCATION') END;\n SELECT CASE WHEN NEW.amount_minor+COALESCE((SELECT SUM(a.amount_minor) FROM prepaid_allocations a JOIN prepaid_events e ON e.id=a.event_id WHERE a.fund_id=NEW.fund_id AND e.deleted_at_ms IS NULL),0)>(SELECT amount_minor FROM prepaid_events WHERE id=NEW.fund_id) OR NEW.book_minor+COALESCE((SELECT SUM(a.book_minor) FROM prepaid_allocations a JOIN prepaid_events e ON e.id=a.event_id WHERE a.fund_id=NEW.fund_id AND e.deleted_at_ms IS NULL),0)>(SELECT book_minor FROM prepaid_events WHERE id=NEW.fund_id) THEN RAISE(ABORT,'PREPAID_ALLOCATION') END;\n END;",
  "CREATE TRIGGER prepaid_allocation_no_update BEFORE UPDATE ON prepaid_allocations BEGIN SELECT RAISE(ABORT,'PREPAID_HISTORY_LOCKED'); END;",
  "CREATE TRIGGER prepaid_transaction_finance_lock BEFORE UPDATE OF posting_state,paid_minor,book_minor,currency_id,category_id,book_id,include_in_assets,include_in_budget,deleted_at_ms ON transactions\n WHEN EXISTS(SELECT 1 FROM v_prepaid_events WHERE transaction_id=OLD.id)\n BEGIN SELECT RAISE(ABORT,'PREPAID_LINKED_TRANSACTION'); END;",
  "CREATE TRIGGER prepaid_account_delete_guard BEFORE UPDATE OF deleted_at_ms ON accounts\n WHEN NEW.deleted_at_ms IS NOT NULL AND EXISTS(SELECT 1 FROM prepaid_events WHERE account_id=OLD.id)\n BEGIN SELECT RAISE(ABORT,'account has prepaid history'); END;",
  "CREATE VIEW v_effective_movements AS\n SELECT m.* FROM account_movements m JOIN v_posted_transactions t ON t.id=m.transaction_id WHERE t.include_in_assets=1 AND t.balance_mode='apply'\n UNION ALL SELECT m.* FROM account_movements m JOIN balance_adjustments a ON a.id=m.adjustment_id WHERE a.posting_state='posted'\n UNION ALL SELECT r.id,r.account_id,r.account_currency_id,r.transaction_id,NULL,'income',r.account_minor,r.occurred_at_ms FROM v_expense_recoveries r WHERE r.account_id IS NOT NULL AND r.balance_mode='apply'\n UNION ALL SELECT e.id,e.account_id,e.account_currency_id,NULL,NULL,CASE WHEN e.kind='fund' THEN 'expense' ELSE 'income' END,CASE WHEN e.kind='fund' THEN -e.cash_minor ELSE e.cash_minor END,e.occurred_at_ms FROM v_prepaid_events e WHERE e.kind IN ('fund','refund');",
  "CREATE TRIGGER prepaid_attachment_insert BEFORE INSERT ON prepaid_event_attachments\n WHEN NOT EXISTS(SELECT 1 FROM prepaid_events WHERE id=NEW.event_id AND posting_state='draft')\n BEGIN SELECT RAISE(ABORT,'PREPAID_HISTORY_LOCKED'); END;",
  "CREATE TRIGGER prepaid_attachment_no_update BEFORE UPDATE ON prepaid_event_attachments BEGIN SELECT RAISE(ABORT,'PREPAID_HISTORY_LOCKED'); END;",
  "CREATE TRIGGER prepaid_event_no_restore BEFORE UPDATE OF deleted_at_ms ON prepaid_events\n WHEN OLD.deleted_at_ms IS NOT NULL\n BEGIN SELECT RAISE(ABORT,'PREPAID_HISTORY_LOCKED'); END;",
  "CREATE TRIGGER book_currency_locked BEFORE UPDATE OF base_currency_id ON books\n WHEN NEW.base_currency_id<>OLD.base_currency_id AND\n (EXISTS(SELECT 1 FROM transactions WHERE book_id=OLD.id) OR EXISTS(SELECT 1 FROM budgets WHERE book_id=OLD.id) OR EXISTS(SELECT 1 FROM prepaid_projects WHERE book_id=OLD.id))\n BEGIN SELECT RAISE(ABORT,'book currency is in use'); END;",
  "CREATE TRIGGER prepaid_event_publish BEFORE UPDATE OF posting_state ON prepaid_events\n WHEN OLD.posting_state='draft' AND NEW.posting_state='posted'\n BEGIN\n SELECT CASE WHEN NEW.kind<>'fund' AND ((SELECT COALESCE(SUM(amount_minor),0) FROM prepaid_allocations WHERE event_id=NEW.id)<>NEW.amount_minor OR (SELECT COALESCE(SUM(book_minor),0) FROM prepaid_allocations WHERE event_id=NEW.id)<>NEW.book_minor) THEN RAISE(ABORT,'PREPAID_ALLOCATION') END;\n SELECT CASE WHEN NEW.kind='consume' AND ((NEW.book_minor=0 AND NEW.transaction_id IS NOT NULL) OR (NEW.book_minor>0 AND NOT EXISTS(SELECT 1 FROM transactions t JOIN prepaid_projects p ON p.id=NEW.project_id WHERE t.id=NEW.transaction_id AND t.book_id=p.book_id AND t.kind='expense' AND t.currency_id=(SELECT base_currency_id FROM books WHERE id=p.book_id) AND t.paid_minor=NEW.book_minor AND t.book_minor=NEW.book_minor AND t.include_in_assets=0 AND t.posting_state='posted' AND t.deleted_at_ms IS NULL AND NOT EXISTS(SELECT 1 FROM account_movements WHERE transaction_id=t.id)))) THEN RAISE(ABORT,'PREPAID_ALLOCATION') END;\n END;",
  "CREATE TRIGGER book_deletion_context_insert BEFORE INSERT ON book_deletion_context BEGIN\n SELECT CASE WHEN NOT EXISTS(SELECT 1 FROM books WHERE id=NEW.book_id AND revision=NEW.revision AND archived_at_ms IS NOT NULL AND deleted_at_ms IS NULL)\n OR EXISTS(SELECT 1 FROM db_meta WHERE key='active_book_id' AND value=NEW.book_id) THEN RAISE(ABORT,'BOOK_DELETE_UNAVAILABLE') END;\n SELECT CASE WHEN EXISTS(SELECT 1 FROM v_prepaid_balances WHERE book_id=NEW.book_id AND (remaining_minor<>0 OR remaining_book_minor<>0)) THEN RAISE(ABORT,'BOOK_DELETE_PREPAID_OPEN') END;\nEND;",
  "CREATE TRIGGER book_deletion_context_update BEFORE UPDATE ON book_deletion_context BEGIN SELECT RAISE(ABORT,'BOOK_DELETE_CONTEXT_LOCKED'); END;",
  "CREATE TRIGGER transaction_hard_delete BEFORE DELETE ON transactions\n WHEN (OLD.posting_state='posted') AND NOT EXISTS(SELECT 1 FROM book_deletion_context c JOIN books b ON b.id=c.book_id WHERE c.id=1 AND b.archived_at_ms IS NOT NULL AND b.revision=c.revision AND c.book_id=OLD.book_id)\nBEGIN SELECT RAISE(ABORT,'soft delete posted transactions'); END;",
  "CREATE TRIGGER movement_delete_guard BEFORE DELETE ON account_movements\n WHEN (COALESCE((SELECT posting_state FROM transactions WHERE id=OLD.transaction_id),'draft')='posted'\n OR COALESCE((SELECT posting_state FROM balance_adjustments WHERE id=OLD.adjustment_id),'draft')='posted') AND NOT EXISTS(SELECT 1 FROM book_deletion_context c JOIN books b ON b.id=c.book_id WHERE c.id=1 AND b.archived_at_ms IS NOT NULL AND b.revision=c.revision AND c.book_id=(SELECT book_id FROM transactions WHERE id=OLD.transaction_id))\nBEGIN SELECT RAISE(ABORT,'source must be draft'); END;",
  "CREATE TRIGGER fx_delete_guard BEFORE DELETE ON fx_snapshots\n WHEN ((SELECT posting_state FROM transactions WHERE id=OLD.transaction_id)='posted') AND NOT EXISTS(SELECT 1 FROM book_deletion_context c JOIN books b ON b.id=c.book_id WHERE c.id=1 AND b.archived_at_ms IS NOT NULL AND b.revision=c.revision AND c.book_id=(SELECT book_id FROM transactions WHERE id=OLD.transaction_id))\nBEGIN SELECT RAISE(ABORT,'FX source must be draft'); END;",
  "CREATE TRIGGER transfer_details_delete BEFORE DELETE ON transfer_details\n WHEN (EXISTS(SELECT 1 FROM transactions WHERE id=OLD.transaction_id AND posting_state='posted')) AND NOT EXISTS(SELECT 1 FROM book_deletion_context c JOIN books b ON b.id=c.book_id WHERE c.id=1 AND b.archived_at_ms IS NOT NULL AND b.revision=c.revision AND c.book_id=(SELECT book_id FROM transactions WHERE id=OLD.transaction_id))\nBEGIN SELECT RAISE(ABORT,'posted transfer details cannot be deleted'); END;",
  "CREATE TRIGGER fx_transfer_details_delete BEFORE DELETE ON fx_transfer_details\n WHEN (EXISTS(SELECT 1 FROM transactions WHERE id=OLD.transaction_id AND posting_state='posted')) AND NOT EXISTS(SELECT 1 FROM book_deletion_context c JOIN books b ON b.id=c.book_id WHERE c.id=1 AND b.archived_at_ms IS NOT NULL AND b.revision=c.revision AND c.book_id=(SELECT book_id FROM transactions WHERE id=OLD.transaction_id))\nBEGIN SELECT RAISE(ABORT,'posted transfer details cannot be deleted'); END;",
  "CREATE TRIGGER recovery_no_hard_delete BEFORE DELETE ON expense_recoveries\n WHEN (1) AND NOT EXISTS(SELECT 1 FROM book_deletion_context c JOIN books b ON b.id=c.book_id WHERE c.id=1 AND b.archived_at_ms IS NOT NULL AND b.revision=c.revision AND c.book_id=OLD.book_id)\nBEGIN SELECT RAISE(ABORT,'recovery history must be soft-deleted'); END;",
  "CREATE TRIGGER import_row_delete_guard BEFORE DELETE ON import_rows\n WHEN ((SELECT status FROM import_batches WHERE id=OLD.batch_id)='committed') AND NOT EXISTS(SELECT 1 FROM book_deletion_context c JOIN books b ON b.id=c.book_id WHERE c.id=1 AND b.archived_at_ms IS NOT NULL AND b.revision=c.revision AND c.book_id=(SELECT book_id FROM import_batches WHERE id=OLD.batch_id))\nBEGIN SELECT RAISE(ABORT,'committed import rows are immutable'); END;",
  "CREATE TRIGGER prepaid_project_no_delete BEFORE DELETE ON prepaid_projects\n WHEN (1) AND NOT EXISTS(SELECT 1 FROM book_deletion_context c JOIN books b ON b.id=c.book_id WHERE c.id=1 AND b.archived_at_ms IS NOT NULL AND b.revision=c.revision AND c.book_id=OLD.book_id)\nBEGIN SELECT RAISE(ABORT,'PREPAID_HISTORY_LOCKED'); END;",
  "CREATE TRIGGER prepaid_event_no_delete BEFORE DELETE ON prepaid_events\n WHEN (1) AND NOT EXISTS(SELECT 1 FROM book_deletion_context c JOIN books b ON b.id=c.book_id WHERE c.id=1 AND b.archived_at_ms IS NOT NULL AND b.revision=c.revision AND c.book_id=(SELECT book_id FROM prepaid_projects WHERE id=OLD.project_id))\nBEGIN SELECT RAISE(ABORT,'PREPAID_HISTORY_LOCKED'); END;",
  "CREATE TRIGGER prepaid_allocation_no_delete BEFORE DELETE ON prepaid_allocations\n WHEN (1) AND NOT EXISTS(SELECT 1 FROM book_deletion_context c JOIN books b ON b.id=c.book_id WHERE c.id=1 AND b.archived_at_ms IS NOT NULL AND b.revision=c.revision AND c.book_id=(SELECT p.book_id FROM prepaid_events e JOIN prepaid_projects p ON p.id=e.project_id WHERE e.id=OLD.event_id))\nBEGIN SELECT RAISE(ABORT,'PREPAID_HISTORY_LOCKED'); END;",
  "CREATE TRIGGER prepaid_attachment_no_delete BEFORE DELETE ON prepaid_event_attachments\n WHEN (1) AND NOT EXISTS(SELECT 1 FROM book_deletion_context c JOIN books b ON b.id=c.book_id WHERE c.id=1 AND b.archived_at_ms IS NOT NULL AND b.revision=c.revision AND c.book_id=(SELECT p.book_id FROM prepaid_events e JOIN prepaid_projects p ON p.id=e.project_id WHERE e.id=OLD.event_id))\nBEGIN SELECT RAISE(ABORT,'PREPAID_HISTORY_LOCKED'); END;",
  "CREATE TRIGGER book_physical_delete BEFORE DELETE ON books BEGIN\n SELECT CASE WHEN OLD.archived_at_ms IS NULL OR NOT EXISTS(SELECT 1 FROM book_deletion_context WHERE id=1 AND book_id=OLD.id AND revision=OLD.revision)\n OR EXISTS(SELECT 1 FROM db_meta WHERE key='active_book_id' AND value=OLD.id) THEN RAISE(ABORT,'BOOK_DELETE_UNAVAILABLE') END;\n SELECT CASE WHEN EXISTS(SELECT 1 FROM v_prepaid_balances WHERE book_id=OLD.id AND (remaining_minor<>0 OR remaining_book_minor<>0)) THEN RAISE(ABORT,'BOOK_DELETE_PREPAID_OPEN') END;\n SELECT CASE WHEN (SELECT COUNT(*) FROM book_deletion_balances)<>(SELECT COUNT(*) FROM accounts)\n OR EXISTS(SELECT 1 FROM book_deletion_balances p JOIN accounts a ON a.id=p.account_id WHERE p.currency_id<>a.currency_id OR p.expected_minor<>(SELECT balance_minor FROM v_account_balances WHERE account_id=p.account_id)) THEN RAISE(ABORT,'BOOK_DELETE_BALANCE_CHANGED') END;\n INSERT OR IGNORE INTO book_deletion_resources SELECT a.relative_path FROM attachments a WHERE EXISTS(SELECT 1 FROM transaction_attachments l JOIN transactions t ON t.id=l.transaction_id WHERE l.attachment_id=a.id AND t.book_id=OLD.id) OR EXISTS(SELECT 1 FROM prepaid_event_attachments l JOIN prepaid_events e ON e.id=l.event_id JOIN prepaid_projects p ON p.id=e.project_id WHERE l.attachment_id=a.id AND p.book_id=OLD.id);\n INSERT OR IGNORE INTO book_deletion_resources SELECT substr(icon_key,10) FROM category_history WHERE book_id=OLD.id AND icon_key LIKE 'resource:%';\n INSERT OR IGNORE INTO book_deletion_resources SELECT substr(n.icon_key,10) FROM category_history_nodes n JOIN category_history h ON h.id=n.snapshot_id WHERE h.book_id=OLD.id AND n.icon_key LIKE 'resource:%';\n INSERT OR IGNORE INTO book_deletion_resources SELECT substr(icon_key,10) FROM categories WHERE book_id=OLD.id AND icon_key LIKE 'resource:%';\n INSERT OR IGNORE INTO book_deletion_merchants SELECT merchant_id FROM transactions WHERE book_id=OLD.id AND merchant_id IS NOT NULL;\n DELETE FROM transaction_attachments WHERE transaction_id IN (SELECT id FROM transactions WHERE book_id=OLD.id);\n DELETE FROM transaction_tags WHERE book_id=OLD.id;\n DELETE FROM fx_snapshots WHERE transaction_id IN (SELECT id FROM transactions WHERE book_id=OLD.id);\n DELETE FROM account_movements WHERE transaction_id IN (SELECT id FROM transactions WHERE book_id=OLD.id);\n DELETE FROM transfer_details WHERE transaction_id IN (SELECT id FROM transactions WHERE book_id=OLD.id);\n DELETE FROM fx_transfer_details WHERE transaction_id IN (SELECT id FROM transactions WHERE book_id=OLD.id);\n DELETE FROM expense_recoveries WHERE book_id=OLD.id;\n DELETE FROM prepaid_event_attachments WHERE event_id IN (SELECT e.id FROM prepaid_events e JOIN prepaid_projects p ON p.id=e.project_id WHERE p.book_id=OLD.id);\n DELETE FROM prepaid_allocations WHERE event_id IN (SELECT e.id FROM prepaid_events e JOIN prepaid_projects p ON p.id=e.project_id WHERE p.book_id=OLD.id);\n DELETE FROM prepaid_events WHERE project_id IN (SELECT id FROM prepaid_projects WHERE book_id=OLD.id);\n DELETE FROM prepaid_projects WHERE book_id=OLD.id;\n DELETE FROM transactions WHERE book_id=OLD.id;\n DELETE FROM budget_lines WHERE book_id=OLD.id;\n DELETE FROM budget_nature_lines WHERE book_id=OLD.id;\n DELETE FROM budgets WHERE book_id=OLD.id;\n DELETE FROM tags WHERE book_id=OLD.id;\n DELETE FROM category_history_nodes WHERE snapshot_id IN (SELECT id FROM category_history WHERE book_id=OLD.id);\n DELETE FROM category_history WHERE book_id=OLD.id;\n DELETE FROM categories WHERE book_id=OLD.id;\n DELETE FROM category_references WHERE book_id=OLD.id;\n DELETE FROM import_rows WHERE batch_id IN (SELECT id FROM import_batches WHERE book_id=OLD.id);\n DELETE FROM import_batches WHERE book_id=OLD.id;\n DELETE FROM merchants WHERE id IN (SELECT id FROM book_deletion_merchants) AND NOT EXISTS(SELECT 1 FROM transactions WHERE merchant_id=merchants.id);\n DELETE FROM attachments WHERE relative_path IN (SELECT relative_path FROM book_deletion_resources) AND NOT EXISTS(SELECT 1 FROM transaction_attachments WHERE attachment_id=attachments.id) AND NOT EXISTS(SELECT 1 FROM prepaid_event_attachments WHERE attachment_id=attachments.id) AND NOT EXISTS(SELECT 1 FROM categories WHERE icon_key='resource:'||attachments.relative_path) AND NOT EXISTS(SELECT 1 FROM accounts WHERE icon_key='resource:'||attachments.relative_path) AND NOT EXISTS(SELECT 1 FROM category_history_nodes WHERE icon_key='resource:'||attachments.relative_path);\n INSERT OR IGNORE INTO book_deletion_files SELECT relative_path FROM book_deletion_resources WHERE NOT EXISTS(SELECT 1 FROM attachments a WHERE a.relative_path=book_deletion_resources.relative_path) AND NOT EXISTS(SELECT 1 FROM categories c WHERE c.icon_key='resource:'||book_deletion_resources.relative_path) AND NOT EXISTS(SELECT 1 FROM accounts a WHERE a.icon_key='resource:'||book_deletion_resources.relative_path) AND NOT EXISTS(SELECT 1 FROM category_history_nodes n WHERE n.icon_key='resource:'||book_deletion_resources.relative_path);\n INSERT INTO balance_adjustments(id,account_id,kind,before_minor,after_minor,delta_minor,reason,occurred_at_ms,created_at_ms)\n SELECT p.adjustment_id,p.account_id,'calibration',p.expected_minor-p.carry_minor,p.expected_minor,p.carry_minor,'账本删除余额结转',c.occurred_at_ms,c.occurred_at_ms FROM book_deletion_balances p CROSS JOIN book_deletion_context c WHERE p.carry_minor<>0;\n INSERT INTO account_movements(id,account_id,currency_id,adjustment_id,leg,delta_minor,occurred_at_ms)\n SELECT p.adjustment_id||'-movement',p.account_id,p.currency_id,p.adjustment_id,'adjustment',p.carry_minor,c.occurred_at_ms FROM book_deletion_balances p CROSS JOIN book_deletion_context c WHERE p.carry_minor<>0;\n UPDATE balance_adjustments SET posting_state='posted' WHERE id IN (SELECT adjustment_id FROM book_deletion_balances WHERE carry_minor<>0);\n UPDATE accounts SET revision=revision+1,updated_at_ms=(SELECT occurred_at_ms FROM book_deletion_context) WHERE id IN (SELECT account_id FROM book_deletion_balances WHERE carry_minor<>0);\nEND;",
  "CREATE TRIGGER book_delete_verify AFTER DELETE ON books BEGIN\n SELECT CASE WHEN EXISTS(SELECT 1 FROM book_deletion_balances p WHERE p.expected_minor<>(SELECT balance_minor FROM v_account_balances WHERE account_id=p.account_id)) THEN RAISE(ABORT,'BOOK_DELETE_BALANCE_CHANGED') END;\n DELETE FROM book_deletion_balances;\n DELETE FROM book_deletion_resources;\n DELETE FROM book_deletion_merchants;\n DELETE FROM book_deletion_context;\n SELECT CASE WHEN EXISTS(SELECT 1 FROM pragma_foreign_key_check) THEN RAISE(ABORT,'BOOK_DELETE_FOREIGN_KEY') END;\n SELECT CASE WHEN EXISTS(SELECT 1 FROM pragma_quick_check WHERE quick_check<>'ok') THEN RAISE(ABORT,'BOOK_DELETE_INTEGRITY') END;\nEND;",
  "CREATE VIEW v_historical_categories AS SELECT id,book_id,kind,parent_id,name,icon_key,deleted_at_ms,NULL AS frozen_path,NULL AS frozen_root_id,NULL AS frozen_root_name,NULL AS frozen_root_icon FROM categories UNION ALL SELECT id,book_id,kind,NULL,name,icon_key,NULL,path,root_id,root_name,root_icon FROM category_history;",
  "CREATE TRIGGER category_reference_insert AFTER INSERT ON categories BEGIN INSERT INTO category_references VALUES(NEW.id,NEW.book_id,NEW.kind); END;",
  "CREATE TRIGGER category_reference_reuse BEFORE INSERT ON categories WHEN EXISTS(SELECT 1 FROM category_references WHERE id=NEW.id) BEGIN SELECT RAISE(ABORT,'CATEGORY_ID_REUSED'); END;",
  "CREATE TRIGGER category_transaction_insert BEFORE INSERT ON transactions WHEN NEW.category_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM categories WHERE id=NEW.category_id AND book_id=NEW.book_id AND kind=NEW.kind AND deleted_at_ms IS NULL AND archived_at_ms IS NULL) BEGIN SELECT RAISE(ABORT,'CATEGORY_UNAVAILABLE'); END;",
  "CREATE TRIGGER category_transaction_update BEFORE UPDATE OF category_id ON transactions WHEN NEW.category_id IS NOT OLD.category_id AND NEW.category_id IS NOT NULL AND NOT EXISTS(SELECT 1 FROM categories WHERE id=NEW.category_id AND book_id=NEW.book_id AND kind=NEW.kind AND deleted_at_ms IS NULL AND archived_at_ms IS NULL) BEGIN SELECT RAISE(ABORT,'CATEGORY_UNAVAILABLE'); END;",
  "CREATE TRIGGER category_physical_delete BEFORE DELETE ON categories WHEN NOT EXISTS(SELECT 1 FROM book_deletion_context WHERE book_id=OLD.book_id) BEGIN\n SELECT CASE WHEN EXISTS(SELECT 1 FROM categories WHERE parent_id=OLD.id) THEN RAISE(ABORT,'CATEGORY_HAS_CHILDREN') END;\n SELECT CASE WHEN EXISTS(SELECT 1 FROM budget_lines WHERE category_id=OLD.id) THEN RAISE(ABORT,'CATEGORY_HAS_BUDGET') END;\n SELECT CASE WHEN EXISTS(SELECT 1 FROM prepaid_events e JOIN prepaid_projects p ON p.id=e.project_id WHERE p.book_id=OLD.book_id AND (json_extract(e.quote_json,'$.entry.categoryId')=OLD.id OR e.transaction_id IN (SELECT id FROM transactions WHERE category_id=OLD.id))) THEN RAISE(ABORT,'CATEGORY_HAS_PREPAID') END;\n SELECT CASE WHEN OLD.deleted_at_ms IS NULL AND OLD.archived_at_ms IS NULL AND NOT EXISTS(SELECT 1 FROM categories WHERE id<>OLD.id AND book_id=OLD.book_id AND kind=OLD.kind AND deleted_at_ms IS NULL AND archived_at_ms IS NULL) THEN RAISE(ABORT,'LAST_ACTIVE_CATEGORY') END;\n SELECT CASE WHEN EXISTS(SELECT 1 FROM category_delete_tx_proof) OR EXISTS(SELECT 1 FROM category_delete_balance_proof) THEN RAISE(ABORT,'CATEGORY_DELETE_INCOMPLETE') END;\n INSERT INTO category_delete_tx_proof SELECT id,paid_minor,book_minor,revision FROM transactions;\n INSERT INTO category_delete_balance_proof SELECT account_id,balance_minor FROM v_account_balances;\n INSERT INTO category_history SELECT OLD.id,OLD.book_id,OLD.kind,OLD.name,COALESCE(OLD.icon_key,'other'),'',OLD.id,OLD.name,COALESCE(OLD.icon_key,'other'),CAST(strftime('%s','now') AS INTEGER)*1000 WHERE EXISTS(SELECT 1 FROM transactions WHERE category_id=OLD.id);\n INSERT INTO category_history_nodes WITH RECURSIVE path(id,parent_id,name,icon_key,depth) AS (SELECT OLD.id,OLD.parent_id,OLD.name,COALESCE(OLD.icon_key,'other'),0 UNION ALL SELECT c.id,c.parent_id,c.name,COALESCE(c.icon_key,'other'),path.depth+1 FROM categories c JOIN path ON c.id=path.parent_id) SELECT OLD.id,id,parent_id,name,icon_key,depth FROM path WHERE EXISTS(SELECT 1 FROM category_history WHERE id=OLD.id);\n UPDATE category_history SET path=(SELECT group_concat(name,' / ') FROM (SELECT name FROM category_history_nodes WHERE snapshot_id=OLD.id ORDER BY depth DESC)),root_id=(SELECT node_id FROM category_history_nodes WHERE snapshot_id=OLD.id ORDER BY depth DESC LIMIT 1),root_name=(SELECT name FROM category_history_nodes WHERE snapshot_id=OLD.id ORDER BY depth DESC LIMIT 1),root_icon=(SELECT icon_key FROM category_history_nodes WHERE snapshot_id=OLD.id ORDER BY depth DESC LIMIT 1) WHERE id=OLD.id;\nEND;",
  "CREATE TRIGGER category_delete_verify AFTER DELETE ON categories WHEN NOT EXISTS(SELECT 1 FROM book_deletion_context WHERE book_id=OLD.book_id) BEGIN\n SELECT CASE WHEN NOT EXISTS(SELECT 1 FROM book_deletion_context WHERE book_id=OLD.book_id) AND (EXISTS(SELECT * FROM category_delete_tx_proof EXCEPT SELECT id,paid_minor,book_minor,revision FROM transactions) OR EXISTS(SELECT id,paid_minor,book_minor,revision FROM transactions EXCEPT SELECT * FROM category_delete_tx_proof) OR EXISTS(SELECT * FROM category_delete_balance_proof EXCEPT SELECT account_id,balance_minor FROM v_account_balances) OR EXISTS(SELECT account_id,balance_minor FROM v_account_balances EXCEPT SELECT * FROM category_delete_balance_proof)) THEN RAISE(ABORT,'CATEGORY_DELETE_FINANCE_CHANGED') END;\n DELETE FROM category_references WHERE id=OLD.id AND NOT EXISTS(SELECT 1 FROM category_history WHERE id=OLD.id) AND NOT EXISTS(SELECT 1 FROM transactions WHERE category_id=OLD.id);\n DELETE FROM category_delete_tx_proof;\n DELETE FROM category_delete_balance_proof;\n SELECT CASE WHEN EXISTS(SELECT 1 FROM pragma_foreign_key_check) OR EXISTS(SELECT 1 FROM pragma_quick_check WHERE quick_check<>'ok') THEN RAISE(ABORT,'CATEGORY_DELETE_INTEGRITY') END;\nEND;",
  "CREATE TRIGGER category_history_update BEFORE UPDATE ON category_history WHEN NOT EXISTS(SELECT 1 FROM categories WHERE id=OLD.id) BEGIN SELECT RAISE(ABORT,'CATEGORY_HISTORY_IMMUTABLE'); END;",
  "CREATE TRIGGER category_history_delete BEFORE DELETE ON category_history WHEN NOT EXISTS(SELECT 1 FROM book_deletion_context WHERE book_id=OLD.book_id) BEGIN SELECT RAISE(ABORT,'CATEGORY_HISTORY_IMMUTABLE'); END;",
