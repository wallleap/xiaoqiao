import { common } from '@kit.AbilityKit';
import { Driver, ON } from '@kit.TestKit';
import { expect } from '@ohos/hypium';
import { LedgerWorkspace } from '../../../main/ets/data/rdb/LedgerWorkspace';
import { enterAmount, hideAmountKeyboard } from './AmountKeyboardFlow';

/** Runs only inside ExpenseFlow's UUID test database, before that fixture is removed. */
export async function verifyAccountsUI(driver: Driver, host: common.UIAbilityContext, workspace: LedgerWorkspace, month: string): Promise<void> {
  await driver.delayMs(3200);
  await (await driver.findComponent(ON.id('ledger-tab-3'))).click();
  await driver.waitForComponent(ON.id('accounts-page'), 5000);
  expect(await (await driver.findComponent(ON.id('accounts-net'))).getText()).assertEqual('0.00');
  await (await driver.findComponent(ON.id('accounts-create'))).click();
  await driver.waitForComponent(ON.id('account-editor'), 5000);
  await (await driver.findComponent(ON.id('account-name'))).inputText('账户界面测试');
  await driver.delayMs(600); // Wait for native IME attachment before sending Back.
  await driver.pressBack();
  await driver.waitForComponent(ON.id('account-editor'), 5000);
  await enterAmount(driver, 'account-opening', '100.00');
  await hideAmountKeyboard(driver, 'account-opening');
  await driver.waitForComponent(ON.id('account-editor'), 5000);
  await (await driver.findComponent(ON.id('account-choose-style'))).click();
  await (await driver.waitForComponent(ON.id('account-style-wechat_pay'), 5000)).click();
  await driver.delayMs(600);
  expect(await driver.screenCap(host.filesDir + '/xiaoqiao-account-create.png')).assertTrue();
  await (await driver.findComponent(ON.id('account-save'))).click();
  await driver.waitForComponent(ON.id('accounts-page'), 5000);
  await driver.delayMs(3200);
  let overview = await workspace.accountOverview();
  expect(overview.accounts.length).assertEqual(1); expect(overview.netMinor).assertEqual('10000');
  const accountId = overview.accounts[0].id;
  expect(overview.accounts[0].iconKey).assertEqual('wechat_pay');
  expect(await (await driver.findComponent(ON.id('accounts-net'))).getText()).assertEqual('100.00');
  expect((await workspace.snapshot(month)).incomeMinor).assertEqual('0');
  expect(await (await driver.findComponent(ON.id('accounts-total-assets'))).getText()).assertEqual('100.00');
  expect(await (await driver.findComponent(ON.id('accounts-total-liabilities'))).getText()).assertEqual('0.00');
  expect(await driver.screenCap(host.filesDir + '/xiaoqiao-accounts-list.png')).assertTrue();
  await (await driver.findComponent(ON.id('account-row-' + accountId))).click();
  await driver.waitForComponent(ON.id('account-editor'), 5000);
  expect(await driver.findComponent(ON.id('account-opening'))).assertNull();
  expect(await (await driver.findComponent(ON.id('account-current-balance'))).getText()).assertEqual('100.00');
  await (await driver.findComponent(ON.id('account-name'))).inputText('改名账户');
  await driver.delayMs(600); // Wait for native IME attachment before sending Back.
  await driver.pressBack();
  await driver.waitForComponent(ON.id('account-editor'), 5000);
  await (await driver.waitForComponent(ON.id('account-include-net'), 5000)).click();
  await (await driver.findComponent(ON.id('account-save'))).click();
  await driver.waitForComponent(ON.id('accounts-page'), 5000);
  await driver.delayMs(3200);
  expect((await workspace.accountOverview()).netMinor).assertEqual('0');
  expect((await workspace.accountOverview()).accounts[0].revision).assertEqual(2);
  expect(await driver.findComponent(ON.text('改名账户')) !== null).assertTrue();
  expect(await (await driver.findComponent(ON.id('accounts-net'))).getText()).assertEqual('0.00');
  await (await driver.findComponent(ON.id('account-row-' + accountId))).click();
  await driver.waitForComponent(ON.id('account-archive'), 5000);
  expect(await (await driver.findComponent(ON.id('account-name'))).getText()).assertEqual('改名账户');
  await (await driver.findComponent(ON.id('account-archive'))).click();
  await driver.waitForComponent(ON.text('归档这个账户吗？'), 5000);
  await (await driver.findComponent(ON.text('归档'))).click();
  await driver.waitForComponent(ON.id('accounts-page'), 5000);
  await driver.delayMs(3200);
  expect(await driver.findComponent(ON.id('account-row-' + accountId))).assertNull();
  expect((await workspace.accountOverview()).accounts[0].archived).assertTrue();
  expect((await workspace.snapshot(month)).accounts.length).assertEqual(0);
  expect((await workspace.accountOverview()).accounts[0].balanceMinor).assertEqual('10000');
  await (await driver.findComponent(ON.id('accounts-toggle-archive'))).click();
  await (await driver.waitForComponent(ON.id('account-row-' + accountId), 5000)).click();
  await (await driver.waitForComponent(ON.id('account-archive'), 5000)).click();
  await driver.waitForComponent(ON.text('恢复使用这个账户？'), 5000);
  const restore = await driver.findComponents(ON.text('恢复使用'));
  await restore[restore.length - 1].click();
  await driver.waitForComponent(ON.id('accounts-page'), 5000);
  await driver.delayMs(3200);
  expect((await workspace.snapshot(month)).accounts.length).assertEqual(1);
  await (await driver.findComponent(ON.id('ledger-add-expense'))).click();
  await driver.waitForComponent(ON.id('expense-keyboard'), 5000);
  await (await driver.findComponent(ON.text('收入').within(ON.id('expense-kind-selector')))).click();
  await (await driver.findComponent(ON.id('expense-hide-keyboard'))).click();
  await driver.waitForComponent(ON.id('expense-resume-amount'), 5000);
  await (await driver.findComponent(ON.id('expense-account-value'))).click();
  await (await driver.waitForComponent(ON.text('改名账户'), 5000)).click();
  await driver.delayMs(600);
  expect(await (await driver.findComponent(ON.id('expense-account-value'))).getText()).assertEqual('改名账户');
  await (await driver.findComponent(ON.id('expense-amount'))).click();
  await driver.waitForComponent(ON.id('expense-keyboard'), 5000);
  for (const key of ['1', '0']) { await (await driver.findComponent(ON.id('expense-key-' + key))).click(); }
  await (await driver.findComponent(ON.id('expense-key-保存'))).click();
  await driver.waitForComponent(ON.text('工资'), 5000);
  let snapshot = await workspace.snapshot(month);
  expect(snapshot.entries.length).assertEqual(1); expect(snapshot.incomeMinor).assertEqual('1000');
  overview = await workspace.accountOverview();
  expect(overview.accounts[0].balanceMinor).assertEqual('11000'); expect(overview.netMinor).assertEqual('0');
  await (await driver.findComponent(ON.id(snapshot.entries[0].id))).click();
  await (await driver.waitForComponent(ON.id('entry-detail-delete'), 5000)).click();
  await driver.waitForComponent(ON.text('确定删除这笔账目吗？'), 5000);
  const deletes = await driver.findComponents(ON.text('删除')); await deletes[deletes.length - 1].click();
  await driver.waitForComponent(ON.text('开始记第一笔账'), 5000);
  expect((await workspace.accountOverview()).accounts[0].balanceMinor).assertEqual('10000');
}
