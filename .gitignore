# Dependencies and HarmonyOS / Hvigor generated files (all modules)
node_modules/
oh_modules/
build/
.hvigor/
.preview/
.cxx/
.test/
.appanalyzer/

# DevEco Studio / local SDK paths and machine-specific configuration
.idea/
local.properties
*.local.properties
*.local.json5
/.clangd

# Local environment values; keep safe templates under version control
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Private signing material; public certificates are not globally ignored
*.p12
*.pfx
*.jks
*.keystore
*.key
*.private.pem
*_private.pem
/signing/
/signatures/
/signature/

# Application packages; HARs outside build/ may be local dependencies
*.hap
*.hsp
*.app

# Local financial data / SQLite files and sidecars (not SQL source)
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
/runtime-data/
/backups/
/exports/
/imports/

# Python design validators and local tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.cache/

# Generated design/browser execution records; keep tokens and reference data
/docs/design/**/application-audit.json
/docs/design/**/browser-audit.json
/docs/design/**/browser-verification.json
/docs/design/**/*-browser-check.json
/docs/design/**/*-save-check.json
/docs/design/**/figma-sync.json
/docs/design/**/*-figma-sync.json

# Logs, dumps and temporary files
*.log
*.log.*
*.hprof
*.tmp
*.temp
*.swp
*.swo
*~
/tmp/
/temp/

# macOS / Windows metadata
.DS_Store
._*
Thumbs.db
Desktop.ini

# Keep oh-package-lock.json5, build-profile.json5, hvigor configuration,
# shared .clang-format/.clang-tidy, source resources, SQL and design docs.
# Do not globally ignore ZIP/CSV/XLSX/JSON: they may be deliberate fixtures.
# Put private exports and backups in the root folders listed above.
